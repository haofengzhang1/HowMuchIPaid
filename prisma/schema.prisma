generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String          @map("password_hash")
  createdAt     DateTime        @default(now()) @map("created_at")
  people        Person[]        @relation("OwnedPeople")
  asPerson      Person[]        @relation("PersonAccount")
  expenses      Expense[]
  invitesSent   Invite[]        @relation("InvitesSent")
  sharesOwned   NotebookShare[] @relation("SharesOwned")
  sharesJoined  NotebookShare[] @relation("SharesJoined")

  @@map("users")
}

model Invite {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation("InvitesSent", fields: [ownerId], references: [id], onDelete: Cascade)
  email     String
  token     String   @unique
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([email, status])
  @@map("invites")
}

model NotebookShare {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation("SharesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id")
  member    User     @relation("SharesJoined", fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ownerId, memberId])
  @@index([memberId])
  @@map("notebook_shares")
}

model Person {
  id        String    @id @default(cuid())
  ownerId   String    @map("owner_id")
  owner     User      @relation("OwnedPeople", fields: [ownerId], references: [id], onDelete: Cascade)
  userId    String?   @map("user_id")
  user      User?     @relation("PersonAccount", fields: [userId], references: [id], onDelete: SetNull)
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  expenses  Expense[]

  @@index([ownerId])
  @@index([userId])
  @@map("people")
}

model Expense {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  personId  String   @map("person_id")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  category  String
  note      String   @default("")
  spentAt   DateTime @map("spent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([personId])
  @@index([spentAt])
  @@map("expenses")
}
